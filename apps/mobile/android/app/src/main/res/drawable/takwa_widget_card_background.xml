<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared card background for every Takwa home-screen widget (prayer times,
  dua of the day, dhikr of the day). Colors come from widget_colors.xml
  (values/ + values-night/), so this one drawable already adapts to the
  system's light/dark setting — no separate drawable-night variant needed.
-->
<shape xmlns:android="http://schemas.android.com/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="135"
        android:startColor="@color/widget_bg_start"
        android:endColor="@color/widget_bg_end" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_border" />
</shape>
